# Copie para .env (nunca versionar o .env)
HOST=127.0.0.1
PORT=8080
CONTENT_DIR=../content
WEB_DIST=../web/dist
# Contato por e-mail. Destino obrigatório + UM transporte (Resend tem prioridade).
# Sem configuração, o formulário responde 503.
# Resend (API HTTPS; necessário onde SMTP é bloqueado, ex.: Render gratuito):
# RESEND_API_KEY=
# RESEND_FROM=onboarding@resend.dev   # padrão; sem domínio verificado só entrega ao dono da conta
# SMTP (ex.: Gmail com senha de app):
# Gmail: SMTP_PASSWORD é uma senha de app (https://myaccount.google.com/apppasswords).
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=
CONTACT_TO=seu-email@gmail.com
# SMTP_HOST=smtp.gmail.com   # padrão
# SMTP_SECURITY=starttls     # starttls (587, padrão) | tls (465) | none (só teste local)
# SMTP_PORT=587
# opcional: sobe o rate limit da API do GitHub. Nunca é enviado ao navegador.
GITHUB_TOKEN=
RUST_LOG=portfolio_api=info,tower_http=warn
# atrás de proxy (Cloud Run: 1). 0 = acesso direto, usa o IP do socket
TRUSTED_PROXY_HOPS=0
# domínio principal e domínios que redirecionam para ele
# CANONICAL_HOST=portfolio.rafeu.dev
# REDIRECT_HOSTS=portifolio.rafeu.dev
